<!DOCTYPE html>
<html>
    <head>
        <title>Show specific post</title>
        <link rel="stylesheet" href="/style.css">
    </head>

    <body>
        <h1>Here your post in details</h1>
        <div class="posts">
            <p>Your id was <%= post.id %></p>
            <h3 id="username">@<%= post.username %> </h3>
            <h4> <%=post.content %> </h4>
        </div>
    </body>
</html>
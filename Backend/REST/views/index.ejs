<!-- Main tab wala code -->

<!DOCTYPE html>
<html>
    <head>
        <title>Quora Posts</title>
        <link rel="stylesheet" href="style.css">

    </head>

    <body>
        <h1 id="title">Quora Posts</h1>
        <% for(let post of posts) { %>
            <div class="posts">
                <h3 id="username">@<%=post.username%></h3>
                <p><%=post.content%></p>
                <br>
                <a href="http://localhost:8080/posts/<%=post.id%>">Read more</a> &nbsp; &nbsp;&nbsp;
                <a href="http://localhost:8080/posts/<%=post.id%>/edit">Edit</a>

                <form method="POST" action="/posts/<%=post.id%>?_method=DELETE">
                    <button>Delete Post</button>
                </form>

            </div>
        <% } %>

        <br>
        <br>
        <br>

        <a href="http://localhost:8080/posts/new">Create new post</a>
    </body>
</html>